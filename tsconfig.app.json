{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    // The same alias as tsconfig.json. TypeScript reads `paths` to type-check
    // the import; Vite reads `resolve.alias` to actually find the file. Two
    // tools, two settings, and neither one reads the other's.
    "paths": { "@/*": ["./src/*"] },

    "strict": true,

    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
